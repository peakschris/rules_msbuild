load("@rules_go//go:def.bzl", "go_binary", "go_library")

package(default_visibility = ["//visibility:public"])

# The coverlet XPlat "Code Coverage" data collector to stage under `bazel coverage`.
# Defaults to this module's own dev `@nuget` package; a consuming repo whose nuget
# packages live in a different repo (e.g. servicemesh's `@nuget_deps`) overrides it:
#   common --@rules_msbuild//dotnet/tools/coverage:coverlet_collector=@nuget_deps//coverlet.collector
label_flag(
    name = "coverlet_collector",
    build_setting_default = "@nuget//coverlet.collector",
    visibility = ["//visibility:public"],
)

go_library(
    name = "merger_lib",
    srcs = ["merger.go"],
    importpath = "github.com/samhowes/rules_msbuild/dotnet/tools/coverage",
    visibility = ["//visibility:private"],
)

# _lcov_merger for msbuild_test: honors split-coverage-postprocessing, no-ops
# otherwise. See merger.go for the contract.
go_binary(
    name = "merger",
    embed = [":merger_lib"],
    visibility = ["//visibility:public"],
)
