load("@rules_msbuild//dotnet:defs.bzl", "msbuild_library")

msbuild_library(
    name = "contentglobs",
    content = glob(["foo/**"]) + glob(
        ["config/**"],
        exclude = ["*.json"],
    ) + ["appsettings.json"],
    target_framework = "net8.0",
    visibility = ["//visibility:public"],
)
